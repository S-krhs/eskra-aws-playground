{
	"name": "@eskra-aws-playground/media-library",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "rm -rf backend/dist frontend/dist",
		"build": "rm -rf backend/dist && tsc -p backend/tsconfig.json",
		"build:ui": "vite build --config frontend/vite.config.ts",
		"start": "npm run build && npm run build:ui && node backend/dist/server.js",
		"dev:ui": "vite --config frontend/vite.config.ts",
		"test": "vitest run",
		"typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
		"lint": "biome ci . && steiger ./frontend/src",
		"validate": "npm run typecheck && npm run lint && npm run test"
	},
	"dependencies": {
		"@aws-sdk/client-lambda": "^3.1127.0",
		"@eskra-aws-playground/integration-r2": "0.1.0",
		"@eskra-aws-playground/repositories": "0.1.0",
		"@eskra-aws-playground/shared-domains": "0.1.0",
		"@hono/node-server": "^2.1.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-virtual": "^3.14.10",
		"hono": "^4.13.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"steiger": "^0.6.0",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0"
	}
}
