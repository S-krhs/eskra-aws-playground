---
/** What the shell shared by every page is given; `title` becomes the `<title>` verbatim */
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<link rel="icon" href="/pic/uk0001.jpg" />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
