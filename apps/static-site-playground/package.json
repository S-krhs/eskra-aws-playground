{
	"name": "@eskra-aws-playground/static-site-playground",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "rm -rf dist",
		"dev": "astro dev",
		"dev:stop": "astro dev stop",
		"build": "npm run clean && astro build",
		"preview": "astro preview",
		"preview:stop": "astro preview stop",
		"typecheck": "astro sync && tsc -p tsconfig.json --noEmit",
		"lint": "biome ci . && steiger ./src",
		"validate": "npm run typecheck && npm run lint"
	},
	"dependencies": {
		"@astrojs/react": "^7.1.4",
		"@tailwindcss/vite": "^4.3.5",
		"astro": "^7.4.7",
		"cookie": "^2.0.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@feature-sliced/steiger-plugin": "^0.8.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"steiger": "^0.9.0"
	}
}
