generator client {
  provider            = "prisma-client"
  output              = "../repositories/generated/prisma"
  importFileExtension = "js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../repositories/generated/zod"
}

datasource db {
  provider = "postgresql"
  schemas  = ["anime", "media", "playground"]
}

model ScrapingMetric {
  id           BigInt   @id @default(autoincrement())
  /// @zod.string.min(1)
  dataSourceId String   @map("data_source_id")
  /// @zod.string.min(1)
  label        String
  /// @zod.number.finite()
  value        Float
  scrapedDate  DateTime @map("scraped_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([dataSourceId, scrapedDate])
  // BigQuery 連携が取得日で絞り id 順に keyset pagination するため
  @@index([scrapedDate, id])
  @@map("scraping_metrics")
  @@schema("anime")
}

model GachaEntity {
  poolKey   String   @map("pool_key") @db.VarChar(64)
  name      String   @db.VarChar(128)
  rarity    String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([poolKey, name])
  @@map("gacha_entities")
  @@schema("playground")
}

model DiscordGuildSetting {
  applicationKey String   @map("application_key") @db.VarChar(64)
  guildId        String   @map("guild_id") @db.VarChar(20)
  settingKey     String   @map("setting_key") @db.VarChar(64)
  configuration  Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([applicationKey, guildId, settingKey])
  @@map("discord_guild_settings")
  @@schema("playground")
}

model DiscordUserSetting {
  applicationKey String   @map("application_key") @db.VarChar(64)
  guildId        String   @map("guild_id") @db.VarChar(20)
  userId         String   @map("user_id") @db.VarChar(20)
  settingKey     String   @map("setting_key") @db.VarChar(64)
  configuration  Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([applicationKey, guildId, userId, settingKey])
  @@index([applicationKey, settingKey])
  @@map("discord_user_settings")
  @@schema("playground")
}

model MediaObject {
  id           String    @id @db.Uuid
  objectKey    String    @unique @map("object_key") @db.VarChar(1024)
  logicalPath  String    @map("logical_path") @db.VarChar(512)
  fileName     String    @map("file_name") @db.VarChar(512)
  contentType  String    @map("content_type") @db.VarChar(128)
  byteSize     BigInt    @map("byte_size")
  etag         String    @db.VarChar(128)
  width        Int?
  height       Int?
  durationMs   Int?      @map("duration_ms")
  thumbnailKey String?   @map("thumbnail_key") @db.VarChar(1024)
  uploadedAt   DateTime  @map("uploaded_at") @db.Timestamptz
  syncedAt     DateTime  @map("synced_at") @db.Timestamptz
  trashedAt    DateTime? @map("trashed_at") @db.Timestamptz

  tags MediaObjectTag[]

  @@index([logicalPath])
  // 一覧の既定順(ゴミ箱を除いた新着順)を index だけで引く
  @@index([trashedAt, uploadedAt])
  @@map("media_objects")
  @@schema("media")
}

/// 実体を持たない論理フォルダ。空のフォルダを先に作れるようにするため table で保持する
model MediaFolder {
  path      String   @id @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("media_folders")
  @@schema("media")
}

model MediaTag {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(64)

  mediaObjects MediaObjectTag[]

  @@map("media_tags")
  @@schema("media")
}

model MediaObjectTag {
  mediaObjectId String @map("media_object_id") @db.Uuid
  tagId         Int    @map("tag_id")

  mediaObject MediaObject @relation(fields: [mediaObjectId], references: [id], onDelete: Cascade)
  tag         MediaTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaObjectId, tagId])
  @@index([tagId])
  @@map("media_object_tags")
  @@schema("media")
}

/// 同期の実行単位。進捗表示と、実行中の二重起動判定に使う
model MediaSyncRun {
  id            String    @id @db.Uuid
  startedAt     DateTime  @map("started_at") @db.Timestamptz
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz
  scannedCount  Int       @default(0) @map("scanned_count")
  insertedCount Int       @default(0) @map("inserted_count")
  updatedCount  Int       @default(0) @map("updated_count")
  deletedCount  Int       @default(0) @map("deleted_count")
  error         String?

  @@index([startedAt])
  @@map("media_sync_runs")
  @@schema("media")
}
