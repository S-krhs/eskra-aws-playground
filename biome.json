{
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*",
			"!**/package-lock.json",
			"!repositories/generated",
			"!apps/media-library/openapi.json",
			"!apps/media-library/frontend/src/shared/api/generated"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"style": {
				"useConsistentArrowReturn": {
					"level": "error",
					"options": {
						"style": "always"
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/media-library/**", "apps/static-site-playground/**"],
			"linter": {
				"rules": {
					"nursery": {
						"useSortedClasses": "error",
						"useTailwindShorthandClasses": "error"
					}
				}
			}
		}
	]
}
