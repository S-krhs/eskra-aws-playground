{
	"name": "@eskra-aws-playground/shared-domains",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./media/*.test.js": null,
		"./media/*.js": {
			"types": "./dist/media/*.d.ts",
			"default": "./dist/media/*.js"
		},
		"./discord/*.test.js": null,
		"./discord/*.js": {
			"types": "./dist/discord/*.d.ts",
			"default": "./dist/discord/*.js"
		}
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "npm run clean && tsc -p tsconfig.json",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome ci .",
		"validate": "npm run typecheck && npm run lint && npm run test"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"zod": "^4.5.3"
	}
}
