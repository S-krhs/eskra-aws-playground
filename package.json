{
	"name": "eskra-aws-playground",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "npm@11.8.0",
	"workspaces": [
		"apps/*",
		"infra",
		"packages/integrations/*",
		"packages/libs/*",
		"repositories",
		"shared-domains"
	],
	"scripts": {
		"postinstall": "prisma generate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"build": "turbo run build",
		"build:browser-runtime-layer": "node infra/layers/browser-runtime/build.mjs",
		"deploy": "npm run build && npm run build:browser-runtime-layer && sst deploy --stage develop --config infra/sst.config.ts",
		"discord:sync": "npm run build && sst shell --config infra/sst.config.ts -- npm run discord:sync:run",
		"discord:sync:run": "node apps/function-url-playground/dist/scripts/sync-discord-commands.js",
		"discord:sync:dry": "npm run build && sst shell --config infra/sst.config.ts -- npm run discord:sync:run -- --dry-run",
		"dev": "npm run build && npm run build:browser-runtime-layer && sst dev --config infra/sst.config.ts",
		"test": "turbo run test -- --exclude '**/dist/**'",
		"test:ci": "turbo run test --continue -- --exclude '**/dist/**' --reporter=default --reporter=json --outputFile.json=vitest-report.json",
		"test:summary": "node scripts/ci-test-summary.js",
		"typecheck": "turbo run typecheck",
		"lint": "biome ci . && turbo run lint",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"validate": "npm run typecheck && npm run lint && npm run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^26.4.0",
		"prisma": "^7.10.0",
		"prisma-zod-generator": "^3.3.1",
		"sst": "^4.17.1",
		"turbo": "^2.10.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
